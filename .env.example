# .env.example — copy to .env for local dev; set real values in production.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-value

# Public identity
SITE_NAME=Royal Exotic Farms
# The live public origin, e.g. https://royalexotic-farms.onrender.com (no trailing slash)
SITE_URL=
DEFAULT_OG_IMAGE=img/brand/og-default.jpg

# Organization contact (shown on the site / in structured data)
# Verified values (Udyam certificate + Central KYC record). Placeholder-looking
# values (all-zero numbers, a bare "India" address, example.com emails) are
# ignored at runtime by app/data/organization.py.
ORG_LEGAL_NAME=Royal Exotic Farms
ORG_EMAIL=royalexoticfarms@gmail.com
ORG_PHONE=+91 84688 51240
# OWNER DECISION: set only once the WhatsApp number is confirmed (digits only).
# ORG_WHATSAPP=918468851240
ORG_WHATSAPP=
# OWNER DECISION: public street/locality line. Leave empty to show none.
ORG_ADDRESS=
ORG_REGION=Maharashtra
ORG_COUNTRY=IN

# Database (Postgres in production; sqlite fallback for local dev)
DATABASE_URL=postgresql://user:pass@localhost:5432/royal_exotic_farms

# Internationalization (add ,ar when Arabic launches)
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en

# Mail
# Example for the company Gmail account (requires 2-Step Verification and a
# Google "App password" — never the normal account password):
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   MAIL_USERNAME=royalexoticfarms@gmail.com  MAIL_PASSWORD=<16-char app password>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME, then ORG_EMAIL. Must be an address the SMTP
# account is allowed to send as.
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
# Inbox that receives every inquiry. Defaults to ORG_EMAIL.
SUBMISSION_NOTIFY_EMAIL=royalexoticfarms@gmail.com
SEND_ACK_EMAIL=false
